EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_API_TIMEOUT=30000

# Google OAuth — Web Client ID from Google Cloud Console → Credentials → Web application
# Required only when EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Facebook OAuth — NO env var needed in the app.
# The Facebook App ID + App Secret live ONLY in the Supabase dashboard
# (Authentication → Providers → Facebook). See _docs/_doc_technical/supabase/facebook_auth_setup_guide.md
